# Chave da API do Google Gemini (obrigatória) — gere em https://aistudio.google.com
GEMINI_API_KEY=coloque_sua_chave_aqui
# Modelo usado na chamada (padrão: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
# Criatividade da resposta, 0 a 2 (padrão: 0 = mais previsível)
LLM_TEMPERATURE=0
# Amostragem nucleus, 0 a 1 (padrão: 1.0)
LLM_TOP_P=1.0
# Limite de tokens da resposta, inteiro > 0 (padrão: 1024)
LLM_MAX_TOKENS=1024
# Tempo máximo de espera pela API, em segundos (padrão: 30)
LLM_TIMEOUT_SEGUNDOS=30
# Arquivo .txt (UTF-8) com um prompt de sistema alternativo; vazio = usa o embutido em src/prompt.py
LLM_SYSTEM_PROMPT_ARQUIVO=
# Nível dos logs: DEBUG, INFO, WARNING, ERROR (padrão: INFO)
LOG_LEVEL=INFO
# Arquivo opcional para gravar os logs (ex.: logs/extrator.log); vazio = só no terminal
LOG_ARQUIVO=
